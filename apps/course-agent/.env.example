COURSE_AGENT_DEMO_MODE=true
COURSE_AGENT_SESSION_SECRET=replace-with-a-local-random-secret
COURSE_AGENT_RUNTIME_DIR=../../var/course-agent
COURSE_AGENT_LLM_API_KEY=
COURSE_AGENT_LLM_BASE_URL=
COURSE_AGENT_LLM_MODEL=gpt-5.6-sol
COURSE_AGENT_BRANCH_LLM_MODEL=gpt-5.6-sol
COURSE_AGENT_LLM_TIMEOUT_SECONDS=45
COURSE_AGENT_ADMIN_USER_IDS=demo-a
COURSE_AGENT_ALLOW_LOCAL_LLM_BASE_URLS=false

# Campus Agent Hub integration. Authentication fails closed by default; set
# COURSE_AGENT_HUB_AUTH_REQUIRED=false only for isolated local adapter debugging.
COURSE_AGENT_HUB_AGENT_ID=hanhai-course-agent
COURSE_AGENT_HUB_CONTRACT_VERSION=1.0
COURSE_AGENT_HUB_ISSUER=campus-agent-hub
COURSE_AGENT_HUB_JWKS_URL=http://127.0.0.1:8100/.well-known/jwks.json
COURSE_AGENT_HUB_JWKS_JSON=
COURSE_AGENT_HUB_AUTH_REQUIRED=true
COURSE_AGENT_HUB_TOKEN_ENDPOINT=http://127.0.0.1:8100/oauth/token
COURSE_AGENT_HUB_CLIENT_ID=hanhai-course-agent
COURSE_AGENT_HUB_CLIENT_SECRET=
COURSE_AGENT_HUB_CLIENT_SECRET_FILE=
COURSE_AGENT_HUB_WORKSPACE_REDIRECT_URI=http://127.0.0.1:8002/api/hub/callback
COURSE_AGENT_HUB_RETURN_URL=http://127.0.0.1:8100/
COURSE_AGENT_HUB_USER_MAP=
