{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-for-better-life-in-ustc.local/contracts/campus-agent-hub/v1/simple-chat.schema.json",
  "title": "Campus Agent Hub simple-chat v1",
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "maxLength": 100000 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "run_id", "messages", "context"],
      "properties": {
        "thread_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/message" }
        },
        "context": { "type": "object" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {
          "allOf": [
            { "$ref": "#/$defs/message" },
            {
              "type": "object",
              "properties": { "role": { "const": "assistant" } }
            }
          ]
        },
        "citations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/citation" }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
