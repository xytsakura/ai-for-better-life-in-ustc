# Campus Agent Hub local demo ports.
HUB_DEMO_MODE=true
HUB_PUBLIC_PORT=8100
COURSE_AGENT_PUBLIC_PORT=8002
DEMO_AGENT_PUBLIC_PORT=8101

# Optional Responses-compatible model service used by 瀚海行. Keep the real
# key only in the ignored local .env file.
COURSE_AGENT_LLM_API_KEY=
COURSE_AGENT_LLM_BASE_URL=
COURSE_AGENT_LLM_MODEL=gpt-5.6-sol
COURSE_AGENT_LLM_API_STYLE=responses
COURSE_AGENT_BRANCH_LLM_MODEL=gpt-5.6-sol
COURSE_AGENT_LLM_MAX_OUTPUT_TOKENS=1200

# Optional exact origins for local/private model services used only during
# development. Public HTTPS model services do not need to be listed here.
HUB_MODEL_PROVIDER_ORIGIN_ALLOWLIST=
HUB_ALLOW_LOCAL_MODEL_PROVIDERS=false
HUB_MODEL_PROFILES_ENABLED=false
HUB_MODEL_PROFILE_MASTER_KEY_FILE=
HUB_MODEL_PROFILE_MASTER_KEY_VERSION=1
# Optional key rotation map, comma-separated: version=path/to/old.key
HUB_MODEL_PROFILE_PREVIOUS_KEY_FILES=
HUB_MODEL_GATEWAY_GRANT_TTL_SECONDS=120
HUB_MODEL_DELEGATION_TTL_SECONDS=14400
HUB_MODEL_GATEWAY_TIMEOUT_SECONDS=60

# Optional Hub Model Gateway. When enabled from a Hub workspace, 瀚海行 asks
# Hub for short-lived model grants and never receives the user's API key.
COURSE_AGENT_HUB_MODEL_GATEWAY_ENABLED=false
COURSE_AGENT_HUB_MODEL_GRANT_ENDPOINT=http://127.0.0.1:8100/api/model-gateway/grants/exchange
COURSE_AGENT_HUB_MODEL_GATEWAY_URL=http://127.0.0.1:8100/api/model-gateway/v1/generate
COURSE_AGENT_HUB_MODEL_DELEGATION_TTL_SECONDS=3600
COURSE_AGENT_HUB_MODEL_GATEWAY_TIMEOUT_SECONDS=60

# Copy this file to .env before running:
# docker compose --env-file .env -f deploy/compose.yaml up --build
#
# Do not add runtime-generated Hub client secrets here. deploy/bootstrap_demo.py
# creates the Featured Agent credential at runtime and stores it in a Docker
# volume consumed by course-agent.
